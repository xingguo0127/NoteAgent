# OpenRouter API Key (required)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (optional, default: openrouter/google/gemini-2.5-flash-preview)
# Other options: openrouter/google/gemini-2.0-flash, openrouter/anthropic/claude-3.5-sonnet, etc.
LLM_MODEL=openrouter/google/gemini-2.5-flash-preview

# Git Repository Configuration (required)
# GitHub repository URL for Obsidian vault
# Recommend using SSH URL to avoid authentication prompts:
#   SSH:   git@github.com:username/repo.git (recommended)
#   HTTPS: https://github.com/username/repo.git (needs token/credential helper)
OBSIDIAN_GIT_REPO=git@github.com:your-username/obsidian-vault.git
# Branch name
OBSIDIAN_GIT_BRANCH=main
# Local path where the repo will be cloned/stored
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Clippings folder name inside the vault (optional, default: Clippings)
CLIPPINGS_FOLDER=Clippings

# Server configuration (optional)
HOST=0.0.0.0
PORT=8080
